---
import { translations } from '../i18n/translations';
const t = translations.es;
---

<footer id="contact" class="relative pt-12 sm:pt-16 pb-12 overflow-hidden">
	<!-- Top mesh line -->
	<div class="mesh-line mb-8 sm:mb-10 max-w-5xl mx-auto"></div>

	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<!-- Status Badge -->
		<div class="footer-content text-center mb-8 sm:mb-10">
			<div class="inline-flex items-center gap-2.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-4 py-1.5 text-xs sm:text-sm font-medium text-emerald-300 backdrop-blur-sm mb-4 sm:mb-6">
				<span class="inline-block h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
				<span data-i18n="footer.status">{t.footer.status}</span>
			</div>

			<h2 class="text-3xl sm:text-4xl font-bold font-display text-white mb-4">
				Let's <span class="text-rose-500">connect</span>
			</h2>
		</div>

		<!-- Contact Links Grid -->
		<div class="footer-links grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto mb-10 sm:mb-12">
			<!-- Formulario de contacto -->
			<a
				href="/contacto"
				class="contact-card group flex flex-col items-center gap-3 p-5 spotlight-card glass rounded-2xl glow-hover"
				id="email-link"
				aria-label="Ir al formulario de contacto"
			>
				<div class="w-12 h-12 rounded-xl bg-rose-500/15 border border-rose-500/25 flex items-center justify-center group-hover:bg-rose-500/25 transition-colors">
					<svg class="w-5 h-5 text-rose-400 group-hover:text-rose-300 transition-colors" fill="currentColor" viewBox="0 0 24 24">
						<path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L5.455 4.64 12 9.548l6.545-4.91 1.528-1.145C21.69 2.28 24 3.434 24 5.457z"/>
					</svg>
				</div>
				<span class="text-sm font-medium text-slate-300 group-hover:text-white transition-colors font-mono" data-i18n="footer.contactLabel">{t.footer.contactLabel}</span>
			</a>

			<!-- GitHub -->
			<a
				href="https://github.com/AndrewsB05"
				target="_blank"
				rel="noopener noreferrer"
				class="contact-card group flex flex-col items-center gap-3 p-5 spotlight-card glass rounded-2xl glow-hover"
				aria-label="Ver perfil de GitHub"
			>
				<div class="w-12 h-12 rounded-xl bg-slate-500/15 border border-slate-500/25 flex items-center justify-center group-hover:bg-slate-500/25 transition-colors">
					<svg class="w-5 h-5 text-slate-300" fill="currentColor" viewBox="0 0 24 24">
						<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
					</svg>
				</div>
				<span class="text-sm font-medium text-slate-300 group-hover:text-white transition-colors font-mono" data-i18n="footer.githubLabel">{t.footer.githubLabel}</span>
			</a>

			<!-- LinkedIn -->
			<a
				href="https://linkedin.com/in/TU_USUARIO"
				target="_blank"
				rel="noopener noreferrer"
				class="contact-card group flex flex-col items-center gap-3 p-5 spotlight-card glass rounded-2xl glow-hover"
				id="linkedin-link"
				aria-label="Ver perfil de LinkedIn"
			>
				<div class="w-12 h-12 rounded-xl bg-cyan-500/15 border border-cyan-500/25 flex items-center justify-center group-hover:bg-cyan-500/25 transition-colors">
					<svg class="w-5 h-5 text-cyan-400" fill="currentColor" viewBox="0 0 24 24">
						<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
					</svg>
				</div>
				<span class="text-sm font-medium text-slate-300 group-hover:text-white transition-colors font-mono" data-i18n="footer.linkedinLabel">{t.footer.linkedinLabel}</span>
			</a>

			<!-- CV Download -->
			<a
				href="#"
				class="contact-card group flex flex-col items-center gap-3 p-5 spotlight-card glass rounded-2xl glow-hover"
				aria-label="Descargar CV"
			>
				<div class="w-12 h-12 rounded-xl bg-rose-500/15 border border-rose-500/25 flex items-center justify-center group-hover:bg-rose-500/25 transition-colors">
					<svg class="w-5 h-5 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
					</svg>
				</div>
				<span class="text-sm font-medium text-slate-300 group-hover:text-white transition-colors font-mono" data-i18n="footer.cvLabel">{t.footer.cvLabel}</span>
			</a>
		</div>

		<!-- Bottom bar -->
		<div class="mesh-line mb-6 max-w-5xl mx-auto"></div>
		<div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs sm:text-sm text-slate-500 font-mono">
			<p data-i18n="footer.copyright">{t.footer.copyright}</p>
			<p data-i18n="footer.builtWith">{t.footer.builtWith}</p>
		</div>
	</div>
</footer>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	// === Spotlight effect on footer cards ===
	const contactCards = document.querySelectorAll<HTMLElement>('.contact-card');
	contactCards.forEach((card) => {
		card.addEventListener('mousemove', (e) => {
			const rect = card.getBoundingClientRect();
			const x = e.clientX - rect.left;
			const y = e.clientY - rect.top;
			card.style.setProperty('--mouse-x', `${x}px`);
			card.style.setProperty('--mouse-y', `${y}px`);
		});
	});

	// === GSAP ScrollTrigger Animations (Appear on scroll down, disappear on scroll up) ===
	const mm = gsap.matchMedia();

	mm.add(
		{
			reduceMotion: '(prefers-reduced-motion: reduce)',
			normalMotion: '(prefers-reduced-motion: no-preference)',
		},
		(context) => {
			const { reduceMotion } = context.conditions as { reduceMotion: boolean };

			if (reduceMotion) {
				gsap.set('.footer-content, .contact-card', { opacity: 1, y: 0 });
				return;
			}

			// Footer Header & Status
			gsap.set('.footer-content', { opacity: 0, y: 30 });
			ScrollTrigger.batch('.footer-content', {
				start: 'top 90%',
				onEnter: (batch) => gsap.to(batch, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out', overwrite: 'auto' }),
				onLeaveBack: (batch) => gsap.to(batch, { opacity: 0, y: 30, duration: 0.4, ease: 'power2.in', overwrite: 'auto' }),
			});

			// Contact Cards
			gsap.set('.contact-card', { opacity: 0, y: 40 });
			ScrollTrigger.batch('.contact-card', {
				start: 'top 90%',
				interval: 0.1,
				batchMax: 4,
				onEnter: (batch) => {
					gsap.to(batch, {
						opacity: 1,
						y: 0,
						duration: 0.5,
						stagger: 0.1,
						ease: 'power2.out',
						overwrite: 'auto',
					});
				},
				onLeaveBack: (batch) => {
					gsap.to(batch, {
						opacity: 0,
						y: 40,
						duration: 0.35,
						stagger: 0.05,
						ease: 'power2.in',
						overwrite: 'auto',
					});
				},
			});
		}
	);
</script>
