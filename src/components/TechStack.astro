const categories = t.stack.categories;
---

<section id="stack" class="relative py-14 sm:py-16 overflow-hidden">
	<!-- Ambient glow -->
	<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-[600px] h-[600px] bg-gradient-to-br from-rose-600/5 to-cyan-500/5 blur-[160px] rounded-full pointer-events-none -z-10"></div>

	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<!-- Section Title -->
		<div class="stack-title text-center mb-10 sm:mb-12">
			<h2 class="text-3xl sm:text-4xl font-bold font-display text-white" data-i18n="stack.sectionTitle">{t.stack.sectionTitle}</h2>
			<p class="mt-3 text-slate-400 text-base sm:text-lg" data-i18n="stack.sectionSubtitle">{t.stack.sectionSubtitle}</p>
			<div class="mesh-line w-24 mx-auto mt-4"></div>
		</div>

		<!-- Tech Categories Grid -->
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="stack-grid">
			{categories.map((category, catIndex) => (
				<div class="stack-card spotlight-card glass rounded-2xl p-6 glow-hover" data-cat-index={catIndex}>
					<div class="flex items-center gap-3 mb-5">
						<div class="w-10 h-10 rounded-xl bg-rose-500/15 border border-rose-500/25 flex items-center justify-center text-rose-400">
							<Fragment set:html={categoryIcons[category.name] || categoryIcons['Bases de Datos & APIs']} />
						</div>
						<h3 class="text-lg font-bold font-display text-white" data-cat-name={catIndex}>{category.name}</h3>
					</div>
					<div class="grid grid-cols-3 gap-3">
						{category.items.map((item) => (
							<div class="tech-item group/item flex flex-col items-center gap-2.5 p-3 rounded-xl bg-white/[0.03] border border-white/5 cursor-default">
								<div class="w-8 h-8 flex items-center justify-center transition-transform duration-300 group-hover/item:scale-110">
									{techIcons[item] ? (
										<Fragment set:html={techIcons[item]} />
									) : (
										<svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
										</svg>
									)}
								</div>
								<span class="text-xs text-slate-300 group-hover/item:text-rose-300 transition-colors text-center font-medium font-mono">{item}</span>
							</div>
						))}
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { translations, type Lang } from '../i18n/translations';

	gsap.registerPlugin(ScrollTrigger);

	// === Spotlight Effect on Stack Cards ===
	const stackCards = document.querySelectorAll<HTMLElement>('.stack-card');
	stackCards.forEach((card) => {
		card.addEventListener('mousemove', (e) => {
			const rect = card.getBoundingClientRect();
			const x = e.clientX - rect.left;
			const y = e.clientY - rect.top;
			card.style.setProperty('--mouse-x', `${x}px`);
			card.style.setProperty('--mouse-y', `${y}px`);
		});
	});

	// === GSAP Micro-interactions on Tech Items ===
	const techItems = document.querySelectorAll<HTMLElement>('.tech-item');
	techItems.forEach((item) => {
		item.addEventListener('mouseenter', () => {
			gsap.to(item, { scale: 1.04, duration: 0.2, ease: 'power1.out' });
		});
		item.addEventListener('mouseleave', () => {
			gsap.to(item, { scale: 1, duration: 0.2, ease: 'power1.in' });
		});
	});

	// === GSAP ScrollTrigger Animations (Appear on scroll down, disappear on scroll up) ===
	const mm = gsap.matchMedia();

	mm.add(
		{
			reduceMotion: '(prefers-reduced-motion: reduce)',
			normalMotion: '(prefers-reduced-motion: no-preference)',
		},
		(context) => {
			const { reduceMotion } = context.conditions as { reduceMotion: boolean };

			if (reduceMotion) {
				gsap.set('.stack-title, .stack-card', { opacity: 1, y: 0 });
				return;
			}

			// Section Title
			gsap.set('.stack-title', { opacity: 0, y: 30 });
			ScrollTrigger.batch('.stack-title', {
				start: 'top 88%',
				onEnter: (batch) => gsap.to(batch, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out', overwrite: 'auto' }),
				onLeaveBack: (batch) => gsap.to(batch, { opacity: 0, y: 30, duration: 0.4, ease: 'power2.in', overwrite: 'auto' }),
			});

			// Stack Category Cards
			gsap.set('.stack-card', { opacity: 0, y: 40 });
			ScrollTrigger.batch('.stack-card', {
				start: 'top 88%',
				interval: 0.1,
				batchMax: 4,
				onEnter: (batch) => {
					gsap.to(batch, {
						opacity: 1,
						y: 0,
						duration: 0.6,
						stagger: 0.12,
						ease: 'power2.out',
						overwrite: 'auto',
					});
				},
				onLeaveBack: (batch) => {
					gsap.to(batch, {
						opacity: 0,
						y: 40,
						duration: 0.4,
						stagger: 0.06,
						ease: 'power2.in',
						overwrite: 'auto',
					});
				},
			});
		}
	);

	// === Update category names on language change ===
	window.addEventListener('lang-change', ((e: CustomEvent) => {
		const lang: Lang = e.detail.lang;
		const t = translations[lang];

		t.stack.categories.forEach((cat, i) => {
			const el = document.querySelector(`[data-cat-name="${i}"]`);
			if (el) el.textContent = cat.name;
		});

		ScrollTrigger.refresh();
	}) as EventListener);
</script>
