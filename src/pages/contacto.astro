---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { translations } from '../i18n/translations';
import {
	CONTACT_TOPICS,
	contactDeps,
	createFormToken,
	handleContactSubmission,
	HONEYPOT_FIELD,
	MAX_BODY_BYTES,
	MESSAGE_MAX,
	MESSAGE_MIN,
	NAME_MAX,
	TOKEN_FIELD,
	type ContactField,
	type ContactFormValues,
} from '../lib/contact';

// El resto del sitio es estático; solo esta página corre en el servidor (procesa el POST del formulario).
export const prerender = false;

const t = translations.es;
type AlertKey = keyof typeof t.contact.alerts;

// El formulario lleva un token con fecha y datos personales: nunca se cachea.
Astro.response.headers.set('Cache-Control', 'no-store');

const sent = Astro.url.searchParams.get('enviado') === '1';
let values: ContactFormValues = { name: '', email: '', topic: '', message: '' };
let invalid: ContactField[] = [];
let alert: AlertKey | null = null;

if (Astro.request.method === 'POST') {
	if (contactDeps === null) {
		Astro.response.status = 503;
		alert = 'unavailable';
	} else {
		let clientKey = 'desconocido';
		try {
			clientKey = Astro.clientAddress;
		} catch {
			// Sin IP conocida, todos comparten el mismo límite: más estricto, nunca más permisivo.
		}
		const contentLength = Number(Astro.request.headers.get('content-length'));
		// Antes de leer el cuerpo: un envío enorme se corta sin procesarlo.
		if (Number.isFinite(contentLength) && contentLength > MAX_BODY_BYTES) {
			return new Response('Mensaje demasiado grande', { status: 413 });
		}
		let formData: FormData;
		try {
			formData = await Astro.request.formData();
		} catch {
			formData = new FormData();
		}

		const result = await handleContactSubmission(
			{
				formData,
				siteOrigin: Astro.url.origin,
				origin: Astro.request.headers.get('origin'),
				referer: Astro.request.headers.get('referer'),
				contentLength: Number.isFinite(contentLength) && contentLength > 0 ? contentLength : null,
				clientKey,
			},
			contactDeps,
		);

		switch (result.status) {
			case 'sent':
				// PRG: redirigir evita reenviar el formulario al recargar. El destino es fijo (sin redirección abierta).
				if (result.dropped !== undefined) console.warn('[contacto] envío descartado', { reason: result.dropped });
				return Astro.redirect('/contacto?enviado=1', 303);
			case 'forbidden':
				return new Response('Solicitud no permitida', { status: 403 });
			case 'too-large':
				return new Response('Mensaje demasiado grande', { status: 413 });
			case 'invalid':
				Astro.response.status = 422;
				values = result.values;
				invalid = result.fields;
				alert = 'invalid';
				break;
			case 'rejected':
				Astro.response.status = 422;
				values = result.values;
				alert = result.reason === 'too-many-links' ? 'tooManyLinks' : result.reason;
				break;
			case 'rate-limited':
				Astro.response.status = 429;
				values = result.values;
				alert = 'rateLimited';
				break;
			case 'error':
				Astro.response.status = 502;
				values = result.values;
				alert = 'error';
				console.error('[contacto] falló el envío del email');
				break;
		}
	}
}

const token = contactDeps === null || sent ? null : await createFormToken(contactDeps.secret);
const isInvalid = (name: ContactField): boolean => invalid.includes(name);
const describedBy = (name: ContactField, hint?: string): string | undefined =>
	[hint, isInvalid(name) ? `${name}-error` : undefined].filter((id) => id !== undefined).join(' ') || undefined;

const labelClass = 'text-sm font-semibold text-slate-200';
const inputClass =
	'w-full min-h-11 rounded-xl border border-slate-800 bg-[#12192b]/60 px-3.5 py-2.5 text-sm text-white placeholder:text-slate-500 transition-colors focus:border-rose-500/60 focus:outline-none focus:ring-2 focus:ring-rose-500/25 aria-[invalid=true]:border-rose-500/70';
const hintClass = 'text-xs text-slate-500';
const errorClass = 'text-xs font-medium text-rose-400';
---

<Layout title={t.contact.pageTitle} description={t.contact.intro}>
	<Header />
	<main class="overflow-x-hidden w-full">
		<section class="relative pt-32 sm:pt-36 pb-10">
			<div class="mx-auto max-w-2xl px-4 sm:px-6">
				<div class="text-center mb-8">
					<h1 class="text-3xl sm:text-4xl font-bold font-display text-white" data-i18n="contact.title">{t.contact.title}</h1>
					{!sent && <p class="mt-3 text-slate-400 text-base sm:text-lg" data-i18n="contact.intro">{t.contact.intro}</p>}
					<div class="mesh-line w-24 mx-auto mt-4"></div>
				</div>

				{
					sent ? (
						<div class="glass rounded-2xl p-6 sm:p-8 text-center" role="status">
							<div class="mx-auto mb-4 w-12 h-12 rounded-xl bg-emerald-500/15 border border-emerald-500/25 flex items-center justify-center">
								<svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
								</svg>
							</div>
							<h2 class="text-xl font-bold font-display text-white" data-i18n="contact.doneTitle">{t.contact.doneTitle}</h2>
							<p class="mt-2 text-slate-300" data-i18n="contact.doneText">{t.contact.doneText}</p>
							<a
								href="/"
								class="mt-6 inline-flex items-center justify-center rounded-xl border border-slate-700 bg-[#12192b]/80 px-6 py-3 text-sm font-semibold text-slate-200 transition-all hover:border-slate-500 hover:text-white"
								data-i18n="contact.back"
							>
								{t.contact.back}
							</a>
						</div>
					) : contactDeps === null ? (
						<p class="rounded-xl border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-300" role="alert" data-i18n="contact.alerts.unavailable">
							{t.contact.alerts.unavailable}
						</p>
					) : (
						<form class="glass rounded-2xl p-5 sm:p-7 grid gap-5" method="post" action="/contacto" novalidate>
							{alert !== null && (
								<p class="rounded-xl border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-300" role="alert" data-i18n={`contact.alerts.${alert}`}>
									{t.contact.alerts[alert]}
								</p>
							)}

							<input type="hidden" name={TOKEN_FIELD} value={token} />

							{/* Campo trampa: fuera de la pantalla (no display:none: algunos bots ignoran los campos ocultos). */}
							<div class="absolute -left-[10000px] w-px h-px overflow-hidden" aria-hidden="true">
								<label for="contact-website">Deja este campo vacío</label>
								<input id="contact-website" type="text" name={HONEYPOT_FIELD} tabindex="-1" autocomplete="off" />
							</div>

							<div class="grid gap-1.5">
								<label for="contact-email" class={labelClass} data-i18n="contact.emailLabel">{t.contact.emailLabel}</label>
								<input
									id="contact-email"
									type="email"
									name="email"
									value={values.email}
									required
									maxlength="254"
									autocomplete="email"
									class={inputClass}
									aria-invalid={isInvalid('email') ? 'true' : undefined}
									aria-describedby={describedBy('email', 'contact-email-hint')}
								/>
								<p id="contact-email-hint" class={hintClass} data-i18n="contact.emailHint">{t.contact.emailHint}</p>
								{isInvalid('email') && <p id="email-error" class={errorClass} data-i18n="contact.errors.email">{t.contact.errors.email}</p>}
							</div>

							<div class="grid gap-1.5">
								<label for="contact-name" class={labelClass}>
									<span data-i18n="contact.nameLabel">{t.contact.nameLabel}</span>
									<span class="font-normal text-slate-500" data-i18n="contact.optional">{t.contact.optional}</span>
								</label>
								<input
									id="contact-name"
									type="text"
									name="name"
									value={values.name}
									maxlength={NAME_MAX}
									autocomplete="name"
									class={inputClass}
									aria-invalid={isInvalid('name') ? 'true' : undefined}
									aria-describedby={describedBy('name')}
								/>
								{isInvalid('name') && <p id="name-error" class={errorClass} data-i18n="contact.errors.name">{t.contact.errors.name}</p>}
							</div>

							<div class="grid gap-1.5">
								<label for="contact-topic" class={labelClass} data-i18n="contact.topicLabel">{t.contact.topicLabel}</label>
								<select
									id="contact-topic"
									name="topic"
									required
									class={inputClass}
									aria-invalid={isInvalid('topic') ? 'true' : undefined}
									aria-describedby={describedBy('topic')}
								>
									<option value="" selected={values.topic === ''} disabled data-i18n="contact.topicPlaceholder">
										{t.contact.topicPlaceholder}
									</option>
									{Object.keys(CONTACT_TOPICS).map((value) => (
										<option value={value} selected={values.topic === value} data-i18n={`contact.topics.${value}`}>
											{t.contact.topics[value as keyof typeof CONTACT_TOPICS]}
										</option>
									))}
								</select>
								{isInvalid('topic') && <p id="topic-error" class={errorClass} data-i18n="contact.errors.topic">{t.contact.errors.topic}</p>}
							</div>

							<div class="grid gap-1.5">
								<label for="contact-message" class={labelClass} data-i18n="contact.messageLabel">{t.contact.messageLabel}</label>
								<textarea
									id="contact-message"
									name="message"
									rows="7"
									required
									minlength={MESSAGE_MIN}
									maxlength={MESSAGE_MAX}
									class={`${inputClass} resize-y`}
									aria-invalid={isInvalid('message') ? 'true' : undefined}
									aria-describedby={describedBy('message', 'contact-message-hint')}
								>{values.message}</textarea>
								<p id="contact-message-hint" class={hintClass} data-i18n="contact.messageHint">{t.contact.messageHint}</p>
								{isInvalid('message') && <p id="message-error" class={errorClass} data-i18n="contact.errors.message">{t.contact.errors.message}</p>}
							</div>

							<button
								type="submit"
								class="justify-self-start inline-flex items-center justify-center gap-2 rounded-xl bg-rose-600 px-7 py-3.5 text-sm font-bold text-white shadow-lg shadow-rose-600/30 transition-all hover:bg-rose-500 hover:shadow-rose-600/45 active:scale-[0.98] cursor-pointer"
							>
								<span data-i18n="contact.submit">{t.contact.submit}</span>
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
								</svg>
							</button>
							<p class={hintClass} data-i18n="contact.privacy">{t.contact.privacy}</p>
						</form>
					)
				}
			</div>
		</section>
	</main>
	<Footer />
</Layout>
