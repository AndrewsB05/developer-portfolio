# Formulario de contacto (/contacto). Opcionales: sin ellas la página muestra "no disponible".
# API key de Resend (https://resend.com/api-keys, permiso "Sending access").
RESEND_API_KEY=
# Tu email: el de la cuenta de Resend (sin dominio propio, Resend solo envía a ese correo).
CONTACT_TO_EMAIL=
# Clave para firmar el token del formulario (mínimo 32 caracteres). Generar con: openssl rand -base64 48
CONTACT_FORM_SECRET=
